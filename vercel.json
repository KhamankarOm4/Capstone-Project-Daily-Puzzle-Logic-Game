{
    "rewrites": [
        {
            "source": "/api/auth/callback",
            "destination": "/api/auth/handler.js"
        },
        {
            "source": "/api/auth/google",
            "destination": "/api/auth/google.js"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/|_next/|static/|favicon.ico).*)",
            "destination": "/index.html"
        }
    ]
}